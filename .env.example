@"
# Get a free key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Where ChromaDB persists its local vector store
CHROMA_PERSIST_DIR=./data/chroma_store

# Max self-healing retries before honest "cannot verify" fallback
MAX_RETRIES=2

# Model used for generation + grading (Groq-hosted)
GROQ_MODEL=llama-3.1-8b-instant
"@ | Out-File -FilePath .env.example -Encoding utf8V